# Copy this file to .env and fill in what you have. .env is gitignored — never commit real keys.
#
# Every value here is optional. Rack boots and runs with none of them filled in; each
# integration just degrades on its own (see SETUP.md for exactly how). Drop in a key,
# restart the app, and that vendor switches on — nothing else to configure.

# https://serpapi.com/manage-api-key
# Free tier is 250 searches/month, 4 calls per item — email SerpApi for hackathon credits.
RACK_SERPAPI_API_KEY=

# https://yce.perfectcorp.com/api-console
RACK_PERFECTCORP_API_KEY=
# A SYNTHETIC model image (generate one with Perfect Corp's AI Avatar Generator) —
# never a photograph of a real person.
RACK_PERFECTCORP_MODEL_URL=

# https://www.name.com/account/settings/api
# Sandbox by default (api.dev.name.com, free test registrations). Only point this at
# api.name.com once you're ready to register the real demo domain — that costs money.
RACK_NAMECOM_USERNAME=
RACK_NAMECOM_TOKEN=
RACK_NAMECOM_BASE_URL=https://api.dev.name.com
# Public IP of the deployed app. Without it, registration still happens but no A record
# is written, so leave this blank until you've actually deployed.
RACK_NAMECOM_STOREFRONT_IP=

# https://dashboard.stripe.com/test/apikeys — use the TEST key (sk_test_...), never live.
RACK_STRIPE_SECRET_KEY=
